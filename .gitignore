*.rawlog
.env
# Local-only directories (convention: leading underscore).
# _antdocs/ holds the ANT+ documents; the adopter agreement forbids redistribution.
/_*/
*.zip
*.log
# Local make settings (rider weight etc.)
local.mk
# Editor settings
.vscode/

# OpenStreetMap data cached next to the courses
.osm/
# A rider profile written in the repo root by a local run
/profile.json
# osscycler's own folder layout (see home): if a core or TUI ever runs with
# the checkout as its folder, the rider's data stays out of the repo.
/courses/
/rides/
/workouts/
/api-token
/tui.json
